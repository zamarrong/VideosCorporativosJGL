# Copia este archivo a .env y llena tu propia key. El .env nunca se sube (está en .gitignore).

# ElevenLabs → Settings → API Keys. Solo la usa scripts/voz.mjs.
ELEVENLABS_API_KEY=

# Los dos videos se hicieron con eleven_v4 (ElevenLabs Flows); si tu cuenta lo tiene por API, ponlo aquí.
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_STT_MODEL=scribe_v1

# Voces de los videos que ya existen; cámbialas o agrega las de tus personajes.
# Fernanda – Warm · Natural (narradora de los dos videos)
VOICE_NARRADORA=NyQ87MpRGbszyh7rZLXM
# Chente – The Steady Sales Closer (Mariana, Cliente difícil)
VOICE_MARIANA=dACNVLHaxmfZ3ntCXOnS
# Carlos Mestre Profesional – Mexicano (Ramiro Torres)
VOICE_RAMIRO=2Vpgw9VLLMQfZcOYVGxD
# Sergio López (Andrés, Script de ventas)
VOICE_ANDRES=7EmI9SPdwF8NyYuIn2Vh
VOICE_PATRICIA=4abYcAPVNYAKZqvRRSE0
VOICE_JOAQUIN=PsG8zZfVQJlANLPFtgSu
VOICE_CARMEN=D3ws14YxTqcjPaXEOehR

# Ruta de ffmpeg si no está en el PATH (p. ej. /opt/homebrew/bin/ffmpeg).
FFMPEG=ffmpeg
